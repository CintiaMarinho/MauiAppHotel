<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.MainPage"
    Title="Hotel"
    BackgroundColor="#F1F7FC">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="🏨 MAUI HOTEL"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#1976D2"
                HorizontalOptions="Center"/>

            <Label
                Text="Bem-vindo!"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#163A5F"
                HorizontalOptions="Center"/>

            <Label
                Text="Planeje sua hospedagem"
                FontSize="16"
                TextColor="#64748B"
                HorizontalOptions="Center"/>

            <Border
                BackgroundColor="White"
                Stroke="#D8E7F5"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        Text="Sua próxima hospedagem começa aqui."
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#163A5F"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Consulte as opções e calcule o valor da sua estadia."
                        FontSize="15"
                        TextColor="#475569"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
