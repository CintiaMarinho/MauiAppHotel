<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.SobrePage"
    Title="Sobre"
    BackgroundColor="#F2F7F7">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="🏨"
                FontSize="80"
                HorizontalOptions="Center" />

            <Label
                Text="APP HOTEL"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#008080"
                HorizontalOptions="Center" />

            <Label
                Text="Sobre o aplicativo"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#333333"
                HorizontalOptions="Center" />

            <Label
                Text="Seu conforto é nossa prioridade!"
                FontSize="18"
                TextColor="#008080"
                HorizontalOptions="Center" />

            <BoxView
                HeightRequest="2"
                BackgroundColor="#008080"
                Margin="0,10" />

            <Label
                Text="Este aplicativo foi desenvolvido como atividade prática de Programação Mobile, utilizando .NET MAUI e C#."
                FontSize="16"
                TextColor="#333333"
                HorizontalTextAlignment="Center" />

            <Frame
                BackgroundColor="White"
                BorderColor="#D0E5E5"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="INFORMAÇÕES DO PROJETO"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#008080"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Desenvolvedora"
                        FontSize="14"
                        TextColor="#777777" />

                    <Label
                        Text="Cintia Marinho"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Label
                        Text="Ano de desenvolvimento"
                        FontSize="14"
                        TextColor="#777777" />

                    <Label
                        Text="2026"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#333333" />

                    <Label
                        Text="Tecnologia utilizada"
                        FontSize="14"
                        TextColor="#777777" />

                    <Label
                        Text=".NET MAUI e C#"
                        FontSize="18"
                        TextColor="#333333" />

                </VerticalStackLayout>

            </Frame>

            <Label
                Text="App Hotel © 2026"
                FontSize="14"
                TextColor="#777777"
                HorizontalOptions="Center"
                Margin="0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
