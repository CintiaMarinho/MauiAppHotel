<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.SobrePage"
    Title="Sobre"
    BackgroundColor="#F1F7FC">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- CABEÇALHO -->
            <Border
                BackgroundColor="#1976D2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="APP HOTEL"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Seu conforto é nossa prioridade!"
                        FontSize="16"
                        TextColor="White"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- TÍTULO -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Sobre o aplicativo"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#163A5F"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="Conheça nosso projeto"
                    FontSize="16"
                    TextColor="#60758A"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <!-- INFORMAÇÕES DO PROJETO -->
            <Border
                BackgroundColor="White"
                Stroke="#D8E7F5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="INFORMAÇÕES DO PROJETO"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#163A5F"
                        HorizontalTextAlignment="Center"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#D8E7F5"/>

                    <!-- DESENVOLVEDORA -->
                    <Label
                        Text="Desenvolvedora"
                        FontSize="14"
                        TextColor="#60758A"/>

                    <Label
                        Text="Cintia Marinho"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#163A5F"/>

                    <!-- CURSO -->
                    <Label
                        Text="Curso"
                        FontSize="14"
                        TextColor="#60758A"/>

                    <Label
                        Text="Técnico em Desenvolvimento de Sistemas"
                        FontSize="16"
                        TextColor="#34495E"/>

                    <!-- ANO -->
                    <Label
                        Text="Ano de desenvolvimento"
                        FontSize="14"
                        TextColor="#60758A"/>

                    <Label
                        Text="2026"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#163A5F"/>

                    <!-- TECNOLOGIA -->
                    <Label
                        Text="Tecnologia utilizada"
                        FontSize="14"
                        TextColor="#60758A"/>

                    <Label
                        Text=".NET MAUI e C#"
                        FontSize="16"
                        TextColor="#34495E"/>

                </VerticalStackLayout>
            </Border>

            <!-- RODAPÉ -->
            <Label
                Text="App Hotel © 2026"
                FontSize="14"
                TextColor="#60758A"
                HorizontalTextAlignment="Center"
                Margin="0,5,0,15"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
